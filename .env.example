# Copy to .env and fill in local values: cp .env.example .env
# Shared by Docker Compose and by the services when run on the host.

# order-service database (compose service: postgres)
POSTGRES_DB=commerce
POSTGRES_USER=commerce_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# inventory-service database (compose service: inventory-postgres)
INVENTORY_POSTGRES_DB=inventory
INVENTORY_POSTGRES_USER=inventory_user
INVENTORY_POSTGRES_PASSWORD=change_me
INVENTORY_POSTGRES_HOST=127.0.0.1
INVENTORY_POSTGRES_PORT=5434

# Kafka (compose service: kafka, EXTERNAL listener)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
